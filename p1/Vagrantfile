Vagrant.configure("2") do |config|
	# caja base que va a usar vagrant
	config.vm.box = "bento/ubuntu-24.04"

	# url de la caja base a usar
	config.vm.box_url = ""

	config.vm.define "isainz-rS" do |server|
		# hostname del server
		server.vm.hostname = "isainz-rS"

		# red que se va a usar e IP
		server.vm.network "private_network", ip: "192.168.56.110"
			# virtualbox__intnet: true # porque es una private network

		# configuración del provider de la máquina
		server.vm.provider "virtualbox" do |v|
			v.name = "isainz-rS"
			v.memory = 1024
			v.cpus = 1
		end
		# script que va a ejecutar cuando la máquina esté provisionada
		server.vm.provision :shell, path: "scripts/server.sh"

			# server.vm.provision "shell", inline: <<-SHELL
			# [...]
			# SHELL
			# 	server.vm.provision "shell", path: "scripts/server.sh"
	end
	
	config.vm.define "isainz-rSW" do |worker|
		# hostname del service worker
		worker.vm.hostname = "isainz-rSW"

		# red que se va a usar e IP
		worker.vm.network "private_network", ip: "192.168.56.111"
			# virtualbox__intnet: true # porque es una private network

		# configuración del provider de la máquina
		worker.vm.provider "virtualbox" do |v|
			v.name = "isainz-rSW"
			v.memory = 1024
			v.cpus = 1
		end
		# script que va a ejecutar cuando la máquina esté provisionada
		worker.vm.provision :shell, path: "scripts/worker.sh"

			# worker.vm.provision "shell", inline: <<-SHELL
			# [...]
			# SHELL
			# 	worker.vm.provision "shell", path: "scripts/server.sh"
	end
end
